# astrolabe — phone web UI bridge for the zodiac agent multiplexer.
# Install:  ./install.sh   (copies this to ~/.config/systemd/user/ and enables it)
[Unit]
Description=astrolabe — zodiac phone web UI bridge
After=network-online.target

[Service]
Type=simple
# node + tailscale from the NixOS per-user and system profiles
Environment=PATH=/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/run/wrappers/bin:/usr/local/bin:/usr/bin:/bin
# Environment=ASTROLABE_PORT=7979
# Environment=ASTROLABE_SESSION=main
# Environment=ASTROLABE_HOST=0.0.0.0   # override the tailscale-IP autodetect
# APNs push credentials (ASTROLABE_APNS_*) live here, not in the unit:
EnvironmentFile=-%h/.config/astrolabe/env
ExecStart=/usr/bin/env node %h/claude/zodiac/astrolabe/bridge/main.ts
WorkingDirectory=%h/claude/zodiac/astrolabe/bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
